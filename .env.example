# Use testnet for first deploys. Switch to mainnet for the final hackathon deployment.
VITE_X_LAYER_NETWORK=testnet

# Set after deploying KickoffMarkets.sol.
VITE_KICKOFF_MARKETS_ADDRESS=

# ERC20 collateral used by the market contract. On testnet, deploy KickoffTestUSDC.
VITE_COLLATERAL_TOKEN_ADDRESS=
