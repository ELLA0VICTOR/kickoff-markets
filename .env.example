# Use testnet for first deploys. Switch to mainnet for the final hackathon deployment.
VITE_X_LAYER_NETWORK=testnet

# Set after deploying KickoffMarkets.sol.
VITE_KICKOFF_MARKETS_ADDRESS=

# ERC20 collateral used by the market contract. On testnet, deploy KickoffTestUSDC.
VITE_COLLATERAL_TOKEN_ADDRESS=

# Optional deployed helpers. These are documented for operators; frontend does not require them directly.
VITE_MATCH_CLOCK_HOOK_ADDRESS=
VITE_MATCH_ORACLE_AGENT_ADDRESS=

# Oracle worker settings. Keep private keys out of VITE variables and out of this repo.
ORACLE_PROVIDER=manual
ORACLE_RESULTS_FILE=scripts/oracle-results.json
ORACLE_MATCH_MINUTES=90
ORACLE_RESULT_GRACE_MINUTES=30
X_LAYER_RPC_URL=
FOOTBALL_DATA_API_TOKEN=
ORACLE_RESULT_ENDPOINT=
ORACLE_RESULT_API_KEY=
